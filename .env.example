# ==============================================
# KONFIGURASI ADMIN NEXT.JS - Mantra App
# ==============================================
# CARA PENGGUNAAN:
# 1. Salin file ini menjadi ".env.local" (jangan ubah nama file ini!)
#    cp .env.example .env.local
# 2. Isi nilai pada setiap variabel di bawah sesuai kondisi lokal Anda.
# 3. File ".env.local" TIDAK akan ter-push ke GitHub (sudah ada di .gitignore).
# ==============================================

# URL API Backend Golang
# Sesuaikan jika port backend Anda berbeda.
NEXT_PUBLIC_API_URL=http://localhost:8080

# IP yang diizinkan untuk akses Next.js Dev Server (Hot Module Reload)
# Gunakan ini jika Anda mengakses app dari HP atau perangkat lain di jaringan lokal.
# Isi dengan IP mesin Anda di jaringan lokal (contoh: 192.168.1.100)
# Jika ada lebih dari satu IP, pisahkan dengan koma (contoh: 192.168.1.100,192.168.1.101)
# Kosongkan/hapus baris ini jika hanya akses dari localhost.
ALLOWED_DEV_ORIGINS=
